---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  titre: string;
  vues: { image: ImageMetadata; alt: string; legende: string }[];
}

const { titre, vues } = Astro.props;

// Version haute definition, chargee seulement a l'ouverture en plein ecran.
const pleinEcran = await Promise.all(
  vues.map((vue) => getImage({ src: vue.image, width: 1400, format: 'webp' })),
);

/**
 * Galerie de captures.
 *
 * Sur telephone c'est un rail que l'on fait glisser du doigt, avec calage
 * automatique sur chaque vue et un morceau de la suivante toujours visible :
 * personne n'a besoin qu'on lui explique qu'il y a d'autres images.
 * Sur grand ecran, la meme liste devient une grille. Aucun JavaScript.
 */
---

<section class="galerie" aria-labelledby="titre-galerie">
  <h2 class="mono-label" id="titre-galerie">{titre}</h2>

  <ul class="galerie__piste">
    {
      vues.map((vue, index) => (
        <li class="galerie__vue">
          <figure>
            <button
              type="button"
              class="zoom galerie__cadre"
              data-zoom
              data-zoom-groupe="galerie"
              data-zoom-src={pleinEcran[index]!.src}
              data-zoom-alt={vue.alt}
              data-zoom-legende={vue.legende}
              aria-label={`Agrandir : ${vue.alt}`}
            >
              <Image
                src={vue.image}
                alt={vue.alt}
                widths={[320, 534, 800]}
                sizes="(min-width: 64rem) 20rem, (min-width: 48rem) 30vw, 74vw"
                loading={index < 2 ? 'eager' : 'lazy'}
              />
            </button>
            <figcaption>{vue.legende}</figcaption>
          </figure>
        </li>
      ))
    }
  </ul>

  <p class="galerie__indice" aria-hidden="true">Faites glisser pour voir la suite</p>
</section>

<style>
  .galerie {
    margin-block: clamp(2.5rem, 6vw, 4rem);
  }

  .galerie h2 {
    margin-bottom: 1.1rem;
  }

  .galerie__piste {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 74%;
    gap: 0.85rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* Le rail deborde du conteneur pour toucher les bords de l'ecran, ce qui
       rend le glissement naturel jusqu'au bord du telephone. */
    margin-inline: calc(clamp(1.25rem, 5vw, 3rem) * -1);
    padding-inline: clamp(1.25rem, 5vw, 3rem);
    scroll-padding-inline: clamp(1.25rem, 5vw, 3rem);
    padding-block: 0.25rem 1rem;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .galerie__piste::-webkit-scrollbar {
    display: none;
  }

  .galerie__vue {
    scroll-snap-align: start;
  }

  .galerie__vue figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    height: 100%;
  }

  /*
   * Le fond de la vignette reste sombre dans les deux themes.
   *
   * Ce n'est pas une surface du site, c'est l'interieur d'un ecran de telephone.
   * Les captures sont en 0,47 alors que la boite est en 9/16, il reste donc des
   * bandes sur les cotes : en theme clair elles devenaient blanches autour d'une
   * capture d'application sombre, et cela se lisait comme un defaut d'affichage.
   */
  .galerie__cadre {
    --c-ecran: #08090a;
    overflow: hidden;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-card);
    background: var(--c-ecran);
    box-shadow: var(--ombre-carte);
  }

  .galerie__cadre :global(img) {
    width: 100%;
    /* Proportion d'un telephone. `contain` plutot que `cover` : sur une capture
       d'application, couper le bas revient a couper la barre de navigation,
       c'est a dire la moitie de ce qu'il y a a montrer. */
    aspect-ratio: 9 / 16;
    object-fit: contain;
    background: var(--c-ecran);
  }

  .galerie__vue figcaption {
    font-size: var(--text-sm);
    color: var(--c-text-2);
    line-height: 1.5;
  }

  .galerie__indice {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    color: var(--c-text-3);
  }

  .galerie__indice::after {
    content: ' · Touchez pour agrandir';
  }

  @media (min-width: 40rem) {
    .galerie__piste {
      grid-auto-columns: 42%;
    }
  }

  /* Sur grand ecran, le rail devient une grille : plus rien a faire glisser. */
  @media (min-width: 64rem) {
    .galerie__piste {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-columns: auto;
      gap: 1.75rem 1.5rem;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
      scroll-snap-type: none;
    }

    .galerie__indice {
      display: none;
    }
  }
</style>
