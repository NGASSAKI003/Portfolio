---
/**
 * Navigation mobile, en barre inferieure.
 *
 * Pourquoi en bas : sur un telephone tenu a une main, le haut de l'ecran est
 * hors de portee du pouce. Un menu cache derriere trois traits demande en plus
 * de savoir que ces trois traits sont un menu. Quatre destinations visibles en
 * permanence, avec une icone ET un mot, ne demandent rien a apprendre.
 *
 * Elle disparait sur grand ecran, ou la barre haute reprend la main.
 */
const chemin = Astro.url.pathname.replace(/\/$/, '') || '/';

const estActif = (href: string) =>
  href === '/' ? chemin === '/' : chemin === href || chemin.startsWith(`${href}/`);

const entrees = [
  { libelle: 'Accueil', href: '/' },
  { libelle: 'Projets', href: '/projets' },
  { libelle: 'Parcours', href: '/a-propos' },
  { libelle: 'Contact', href: '/contact' },
] as const;
---

<nav class="dock" data-dock aria-label="Navigation principale">
  <ul>
    {
      entrees.map((entree) => {
        const actif = estActif(entree.href);
        return (
          <li>
            <a href={entree.href} aria-current={actif ? 'page' : undefined}>
              <span class="dock__marque" aria-hidden="true" />
              <span class="dock__icone" aria-hidden="true">
                {entree.href === '/' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                    <path
                      d="M3.5 10.5 12 4l8.5 6.5V19a1.5 1.5 0 0 1-1.5 1.5h-3.5V15h-7v5.5H5A1.5 1.5 0 0 1 3.5 19z"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
                {entree.href === '/projets' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                    <rect x="3.5" y="3.5" width="7" height="7" rx="2" />
                    <rect x="13.5" y="3.5" width="7" height="7" rx="2" />
                    <rect x="3.5" y="13.5" width="7" height="7" rx="2" />
                    <rect x="13.5" y="13.5" width="7" height="7" rx="2" />
                  </svg>
                )}
                {entree.href === '/a-propos' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                    <circle cx="12" cy="8" r="3.6" />
                    <path d="M4.5 20c0-3.6 3.4-6 7.5-6s7.5 2.4 7.5 6" stroke-linecap="round" />
                  </svg>
                )}
                {entree.href === '/contact' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                    <rect x="3" y="5" width="18" height="14" rx="2.5" />
                    <path d="m4 7.5 8 5.5 8-5.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
              </span>
              <span class="dock__mot">{entree.libelle}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .dock {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    background: var(--c-verre);
    backdrop-filter: blur(18px) saturate(1.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    border-top: 1px solid var(--c-line);
    /* La barre s'arrete au dessus de la barre d'accueil des iPhone. */
    padding-bottom: var(--marge-basse);
    transition: transform 0.42s var(--ease-sortie);
  }

  /*
   * Elle s'efface en descendant, comme la barre haute, et revient des qu'on
   * remonte. L'etat est pose depuis le gabarit, qui commande les deux barres
   * ensemble.
   */
  .dock[data-cache='oui'] {
    transform: translateY(100%);
  }

  /* Deux exceptions, identiques a celles de la barre haute : un element qui a
     le focus ne doit pas sortir de l'ecran, et le mouvement se coupe si le
     systeme le demande. */
  .dock:focus-within {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .dock[data-cache='oui'] {
      transform: none;
    }
  }

  .dock ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .dock a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.22rem;
    height: var(--dock);
    color: var(--c-text-3);
    transition:
      color 0.28s var(--ease-sortie),
      transform 0.2s var(--ease-ressort);
  }

  .dock a:active {
    transform: scale(0.92);
  }

  .dock a[aria-current='page'] {
    color: var(--c-accent);
  }

  /* Barre courte au dessus de l'element courant. Elle apparait en largeur,
     ce qui suffit a signaler la page sans clignoter. */
  .dock__marque {
    position: absolute;
    top: 0;
    width: 0;
    height: 2px;
    border-radius: 0 0 3px 3px;
    background: var(--c-accent);
    transition: width 0.4s var(--ease-sortie);
  }

  .dock a[aria-current='page'] .dock__marque {
    width: 1.9rem;
  }

  .dock__icone svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .dock a[aria-current='page'] .dock__icone {
    /* Halo tres doux, pour distinguer sans alourdir. */
    filter: drop-shadow(0 0 8px var(--c-accent-ligne));
  }

  .dock__mot {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  @media (min-width: 48rem) {
    .dock {
      display: none;
    }
  }
</style>
