---
import { PILE } from '../lib/technologies';
import { lisibleSurClair, lisibleSurSombre } from '../lib/couleurs';

/**
 * Grille des technologies.
 *
 * Au repos, les logos sont gris : la grille se lit comme un texte, sans devenir
 * un sapin de Noel. Au survol, chaque logo prend la couleur exacte de sa marque
 * et la tuile se souleve. Au clic, la tuile reste allumee et decouvre ce que
 * j'en fais reellement.
 *
 * Les couleurs de marque sont faites pour un fond blanc : elles sont eclaircies
 * ou assombries au build pour rester lisibles sur les deux themes.
 */
---

<div class="pile">
  {
    PILE.map((groupe) => (
      <section class="pile__groupe reveal">
        <h3 class="mono-label">{groupe.famille}</h3>
        <ul class="pile__grille">
          {groupe.outils.map((outil) => (
            <li>
              <button
                type="button"
                class="tuile"
                data-tuile
                aria-expanded="false"
                style={`--marque-sombre:${lisibleSurSombre(`#${outil.icone.hex}`)};--marque-claire:${lisibleSurClair(`#${outil.icone.hex}`)}`}
              >
                <span class="tuile__haut">
                  <svg
                    class="tuile__logo"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d={outil.icone.path} fill="currentColor" />
                  </svg>
                  <span class="tuile__nom">{outil.nom}</span>
                </span>
                <span class="tuile__note">
                  <span>{outil.note}</span>
                </span>
              </button>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .pile {
    display: grid;
    gap: clamp(2rem, 5vw, 2.75rem);
  }

  .pile__groupe h3 {
    margin-bottom: 0.9rem;
  }

  .pile__grille {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.6rem;
  }

  .tuile {
    position: relative;
    isolation: isolate;
    width: 100%;
    display: grid;
    gap: 0;
    padding: 0.85rem 0.9rem;
    text-align: left;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-card);
    background: var(--c-bg-elev);
    color: var(--c-text-3);
    transition:
      border-color 0.35s var(--ease-sortie),
      background-color 0.35s var(--ease-sortie),
      color 0.35s var(--ease-sortie),
      transform 0.28s var(--ease-ressort);
  }

  /* La couleur de marque, choisie selon le theme. */
  .tuile {
    --marque: var(--marque-sombre);
  }

  :global([data-theme='clair']) .tuile {
    --marque: var(--marque-claire);
  }

  /* Lueur de la couleur de marque, allumee au survol et au clic. */
  .tuile::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(9rem 6rem at 18% 0%, var(--marque), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s var(--ease-sortie);
  }

  @media (hover: hover) {
    .tuile:hover {
      border-color: color-mix(in srgb, var(--marque) 45%, transparent);
      color: var(--marque);
    }

    .tuile:hover::before {
      opacity: 0.13;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tuile:hover {
      transform: translateY(-3px);
    }
  }

  .tuile:active {
    transform: scale(0.97);
  }

  .tuile[aria-expanded='true'] {
    color: var(--marque);
    border-color: color-mix(in srgb, var(--marque) 55%, transparent);
    background: var(--c-surface);
  }

  .tuile[aria-expanded='true']::before {
    opacity: 0.16;
  }

  .tuile__haut {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 1.75rem;
  }

  .tuile__logo {
    width: 1.35rem;
    height: 1.35rem;
    flex-shrink: 0;
    transition: transform 0.45s var(--ease-ressort);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tuile:hover .tuile__logo,
    .tuile[aria-expanded='true'] .tuile__logo {
      transform: scale(1.14) rotate(-6deg);
    }
  }

  .tuile__nom {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--c-text);
    letter-spacing: -0.01em;
  }

  /*
   * La note se deplie en hauteur. `grid-template-rows` de 0fr a 1fr est la
   * seule facon d'animer vers une hauteur automatique sans mesurer en
   * JavaScript.
   */
  .tuile__note {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s var(--ease-sortie);
  }

  .tuile__note > span {
    overflow: hidden;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--c-text-2);
  }

  .tuile[aria-expanded='true'] .tuile__note {
    grid-template-rows: 1fr;
  }

  .tuile[aria-expanded='true'] .tuile__note > span {
    padding-top: 0.6rem;
  }
</style>

<script>
  function initPile() {
    const tuiles = document.querySelectorAll<HTMLButtonElement>('[data-tuile]');
    if (!tuiles.length) return;

    tuiles.forEach((tuile) => {
      if (tuile.dataset.pret === 'oui') return;
      tuile.dataset.pret = 'oui';

      tuile.addEventListener('click', () => {
        const ouvert = tuile.getAttribute('aria-expanded') === 'true';
        // Une seule note ouverte a la fois : la grille reste lisible.
        tuiles.forEach((autre) => autre.setAttribute('aria-expanded', 'false'));
        tuile.setAttribute('aria-expanded', ouvert ? 'false' : 'true');
      });
    });
  }

  initPile();
  document.addEventListener('astro:page-load', initPile);
</script>
