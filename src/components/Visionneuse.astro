---
/**
 * Visionneuse plein ecran.
 *
 * Batie sur l'element `dialog` natif : la touche Echap, le piege de focus, le
 * fond inerte et le retour du focus a l'element d'origine sont fournis par le
 * navigateur. Reecrire tout cela en JavaScript, c'est se tromper quelque part.
 *
 * Une seule visionneuse pour toute la page. Les images cliquables portent
 * `data-zoom` et les attributs qui vont avec ; un seul ecouteur delegue suffit.
 */
---

<dialog class="visionneuse" data-visionneuse aria-labelledby="visionneuse-titre">
  <h2 class="lecteur-seul" id="visionneuse-titre">Image en plein écran</h2>

  <button
    type="button"
    class="visionneuse__fermer"
    data-visionneuse-fermer
    aria-label="Fermer l'image"
  >
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path
        d="M6 6l12 12M18 6L6 18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"></path>
    </svg>
  </button>

  <figure class="visionneuse__cadre">
    <img data-visionneuse-image alt="" />
    <figcaption data-visionneuse-legende></figcaption>
  </figure>
</dialog>

<style>
  .visionneuse {
    width: min(96vw, 90rem);
    max-width: none;
    /*
     * Hauteur definie et non simple plafond : c'est elle qui permet au cadre,
     * puis a l'image, de calculer la place qui leur revient. Avec un simple
     * `max-height`, la hauteur reste indefinie et un `max-height: 100%` plus
     * bas ne se resout pas.
     */
    height: 94dvh;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--c-text);
    overflow: visible;
    display: grid;
  }

  .visionneuse::backdrop {
    background: rgb(4 5 7 / 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .visionneuse[open] {
      animation: visionneuse-entree 0.32s var(--ease-sortie);
    }

    .visionneuse[open]::backdrop {
      animation: visionneuse-fond 0.32s var(--ease-sortie);
    }
  }

  @keyframes visionneuse-entree {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  @keyframes visionneuse-fond {
    from {
      opacity: 0;
    }
  }

  /*
   * L'image prend exactement ce que la legende lui laisse.
   *
   * Elle etait plafonnee a 82dvh, un nombre choisi pour reserver de la place a
   * une legende dont on ignore la hauteur : trop bas quand elle est courte ou
   * absente, et sur un telephone cela laissait cent pixels perdus en bas.
   * La rangee `1fr` a une hauteur definie, donc le `max-height: 100%` de
   * l'image s'y resout, et l'image continue d'epouser son sujet au lieu de
   * s'etendre en boite vide sous sa bordure.
   */
  .visionneuse__cadre {
    margin: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.9rem;
    justify-items: center;
  }

  .visionneuse__cadre img {
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    align-self: center;
    object-fit: contain;
    border-radius: var(--radius-card);
    border: 1px solid var(--c-line-forte);
    box-shadow: var(--ombre-levee);
  }

  .visionneuse__cadre figcaption {
    max-width: 60ch;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--c-text-2);
  }

  .visionneuse__cadre figcaption:empty {
    display: none;
  }

  .visionneuse__fermer {
    position: fixed;
    top: max(1rem, env(safe-area-inset-top));
    right: 1rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 48px : atteignable au pouce sans viser. */
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-pill);
    color: var(--c-text);
    background: var(--c-verre);
    border: 1px solid var(--c-line-forte);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      background-color 0.25s var(--ease-sortie),
      transform 0.2s var(--ease-ressort);
  }

  .visionneuse__fermer:hover {
    background: var(--c-surface);
  }

  .visionneuse__fermer:active {
    transform: scale(0.9);
  }

  /*
   * Telephone et tablette : l'image prend tout l'ecran.
   *
   * Sur un petit ecran, chaque marge se paie cher. Le cadre, sa bordure et son
   * arrondi sont des agrements de bureau ; ici ils volent des pixels a la seule
   * chose qu'on est venu regarder. L'image occupe donc toute la surface, centree,
   * et garde son rapport d'origine : `contain` ne recadre jamais.
   *
   * La legende ne prend plus de rangee, elle se superpose en bas sur un voile
   * degrade. Elle reste lisible sur n'importe quelle image sans rien lui retirer.
   */
  @media (max-width: 63.99rem) {
    .visionneuse {
      width: 100vw;
      height: 100dvh;
      /*
       * La feuille du navigateur impose aux `dialog` un `max-height` de
       * calc(100% - 6px - 2em), soit 774 pixels sur un ecran de 812 : sans
       * cette neutralisation, le plein ecran demande n'est jamais accorde et
       * l'image deborde de son cadre. Meme chose pour la marge automatique,
       * qui recentrerait la boite au lieu de la coller aux bords.
       */
      max-height: none;
      margin: 0;
    }

    .visionneuse__cadre {
      grid-template-rows: 1fr;
      gap: 0;
    }

    .visionneuse__cadre img {
      /*
       * Placee explicitement dans la meme case que la legende, sinon elle se
       * ferait auto-placer dans une rangee suivante : des qu'un element est
       * pose a la main, les autres cherchent la case libre d'apres, et l'image
       * se retrouvait sous la legende, hors de l'ecran.
       */
      grid-area: 1 / 1;
      align-self: center;
      justify-self: center;
      max-width: 100vw;
      max-height: 100dvh;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .visionneuse__cadre figcaption {
      /* Meme case que l'image, posee au bas de l'ecran. */
      grid-area: 1 / 1;
      align-self: end;
      justify-self: stretch;
      max-width: none;
      padding: 2.5rem 1rem calc(1rem + env(safe-area-inset-bottom));
      color: var(--c-text);
      background: linear-gradient(to top, rgb(4 5 7 / 0.85), rgb(4 5 7 / 0));
      /* Le voile ne doit pas intercepter le toucher : un appui sur l'image
         reste un appui sur l'image, et un appui a cote ferme la visionneuse. */
      pointer-events: none;
    }
  }
</style>

<script>
  function initVisionneuse() {
    const boite = document.querySelector<HTMLDialogElement>('[data-visionneuse]');
    if (!boite || boite.dataset.pret === 'oui') return;
    boite.dataset.pret = 'oui';

    const image = boite.querySelector<HTMLImageElement>('[data-visionneuse-image]');
    const legende = boite.querySelector<HTMLElement>('[data-visionneuse-legende]');
    const fermeture = boite.querySelector<HTMLButtonElement>('[data-visionneuse-fermer]');
    if (!image || !legende) return;

    function ouvrir(declencheur: HTMLElement) {
      const source = declencheur.dataset.zoomSrc;
      if (!source) return;
      image!.src = source;
      image!.alt = declencheur.dataset.zoomAlt ?? '';
      legende!.textContent = declencheur.dataset.zoomLegende ?? '';
      boite!.showModal();
    }

    /**
     * Fermeture, et liberation de l'image dans la foulee.
     *
     * L'evenement `close` du `dialog` serait l'endroit naturel pour faire le
     * menage, mais il ne se declenche pas dans tous les contextes de rendu.
     * On ne confie donc rien d'important a un rappel qui peut ne pas venir :
     * le nettoyage se fait ici, sur le chemin que l'on maitrise.
     */
    function fermer() {
      boite!.close();
      image!.removeAttribute('src');
      image!.alt = '';
      legende!.textContent = '';
    }

    // Un seul ecouteur pour toute la page, y compris pour les images ajoutees
    // apres coup par une transition de page.
    document.addEventListener('click', (evenement) => {
      const cible = (evenement.target as Element | null)?.closest<HTMLElement>('[data-zoom]');
      if (cible) ouvrir(cible);
    });

    fermeture?.addEventListener('click', fermer);

    // Clic hors de l'image : le `dialog` occupe toute la zone, on distingue donc
    // le fond de la figure elle meme.
    boite.addEventListener('click', (evenement) => {
      if (!(evenement.target as Element).closest('.visionneuse__cadre img')) fermer();
    });

    // Echap est gere par le navigateur. `cancel` precede la fermeture native et
    // se declenche, lui, de maniere fiable : on en profite pour nettoyer aussi.
    boite.addEventListener('cancel', () => {
      image.removeAttribute('src');
      image.alt = '';
      legende.textContent = '';
    });
  }

  initVisionneuse();
  document.addEventListener('astro:page-load', initVisionneuse);
</script>
