---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FilAriane from '../components/FilAriane.astro';
import PileTechnique from '../components/PileTechnique.astro';
import { SITE, SITE_URL } from '../lib/site';
import {
  graphe,
  noeudFilAriane,
  noeudPage,
  noeudPersonne,
  noeudSiteWeb,
} from '../lib/jsonld';
import portraitOfficiel from '../assets/portraits/portrait-officiel.jpg';

const description =
  "Le parcours de NGASSAKI-NDZA Anaclet Julien : licence en génie informatique à l'ESTAM Pointe-Noire, pile technique, méthode de travail et disponibilité.";

const jsonLd = graphe([
  noeudSiteWeb(),
  noeudPersonne({ complet: true, image: `${SITE_URL}${portraitOfficiel.src}` }),
  noeudPage({
    chemin: '/a-propos',
    titre: 'Parcours',
    description,
    type: 'AboutPage',
    image: `${SITE_URL}/og/a-propos.png`,
  }),
  noeudFilAriane([
    { nom: 'Accueil', chemin: '/' },
    { nom: 'Parcours', chemin: '/a-propos' },
  ]),
]);

const formation = [
  {
    periode: '2023 à 2026',
    titre: 'Licence professionnelle en génie informatique',
    lieu: 'ESTAM, aussi désigné Institut Congo Technologie, Pointe-Noire',
    detail:
      "Spécialisation développement web, mobile et systèmes. Cursus en cours d'achèvement.",
  },
  {
    periode: '2020 à 2023',
    titre: 'Baccalauréat série H2',
    lieu: 'LTC-OCH, Pointe-Noire',
    detail: 'Série technique industrielle.',
  },
];

const methode = [
  {
    titre: 'Le terrain avant la mode',
    texte:
      "Je choisis une technologie pour ce qu'elle résout chez l'utilisateur visé, pas pour ce qu'elle vaut sur un profil. Une application installable a battu une application native sur One Zone parce que mes utilisateurs manquent de place et de forfait, pas parce que c'était plus simple à écrire.",
  },
  {
    titre: 'Les garanties au plus près de la donnée',
    texte:
      "Une règle qui vit uniquement dans le code client finit toujours par être contournée. Je préfère la poser dans la base, là où elle tient même quand le code se trompe.",
  },
  {
    titre: 'Un mode dégradé, toujours',
    texte:
      "Je pars du principe que le réseau va tomber, que l'écran sera petit et que la main sera prise. Ce qui marche dans ces conditions marche partout ailleurs.",
  },
  {
    titre: 'Je livre, puis je corrige',
    texte:
      "Un produit en ligne qui évolue chaque semaine apprend plus vite qu'une spécification parfaite. Encore faut-il pouvoir corriger vite, donc versionner proprement.",
  },
];
---

<Base
  titre="Parcours"
  {description}
  chemin="/a-propos"
  image="/og/a-propos.png"
  {jsonLd}
>
  <section class="tete">
    <div class="shell">
      <FilAriane etapes={[{ nom: 'Accueil', href: '/' }, { nom: 'Parcours' }]} />

      <div class="tete__grille">
        <div>
          <h1 class="display tete__titre entree">Parcours</h1>
          <div class="bio entree" style="--entree-delai:80ms">
            <p>
              Je m'appelle Anaclet Julien NGASSAKI-NDZA. Je termine une licence
              professionnelle en génie informatique à l'ESTAM, à Pointe-Noire, et je
              construis des applications complètes depuis l'interface jusqu'à la base de
              données.
            </p>
            <p>
              Mon projet principal, <a href="/projets/one-zone">One Zone</a>, est une place
              de marché nationale que j'ai conçue et développée seul, et qui tourne
              aujourd'hui en production. C'est là que j'ai appris ce qu'aucun exercice
              d'école ne m'aurait appris : arbitrer entre ce qui serait élégant et ce qui
              marche réellement sur un téléphone d'entrée de gamme, en 3G, à Pointe-Noire.
            </p>
            <p>
              Je cherche un poste ou un stage en développement web, mobile, API et
              intégration d'intelligence artificielle. Sur site à Pointe-Noire ou à
              distance, disponible immédiatement.
            </p>
          </div>
        </div>

        <div class="tete__portrait entree" style="--entree-delai:140ms">
          <Image
            src={portraitOfficiel}
            alt={`Portrait de ${SITE.name}`}
            widths={[320, 480, 700]}
            sizes="(min-width: 64rem) 20rem, (min-width: 44rem) 32vw, 62vw"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-formation">
    <div class="shell">
      <header class="entete-section reveal">
        <p class="eyebrow">01 · Formation</p>
        <h2 class="display entete-section__titre" id="titre-formation">D'où je viens</h2>
      </header>

      <ol class="parcours">
        {
          formation.map((etape) => (
            <li class="parcours__item reveal" >
              <span class="parcours__periode">{etape.periode}</span>
              <div>
                <h3 class="parcours__titre">{etape.titre}</h3>
                <p class="parcours__lieu">{etape.lieu}</p>
                <p class="parcours__detail">{etape.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="titre-pile">
    <div class="shell">
      <header class="entete-section reveal">
        <p class="eyebrow">02 · Outils</p>
        <h2 class="display entete-section__titre" id="titre-pile">Ce avec quoi je travaille</h2>
        <p class="lede">
          Ce que j'utilise réellement, sans pourcentage de maîtrise inventé. Touchez
          un outil pour voir ce que j'en fais.
        </p>
      </header>

      <PileTechnique />
    </div>
  </section>

  <section class="section" aria-labelledby="titre-methode">
    <div class="shell">
      <header class="entete-section reveal">
        <p class="eyebrow">03 · Méthode</p>
        <h2 class="display entete-section__titre" id="titre-methode">Comment je travaille</h2>
      </header>

      <div class="methode">
        {
          methode.map((bloc) => (
            <article class="methode__item halo lueur reveal">
              <h3 class="methode__titre">{bloc.titre}</h3>
              <p class="methode__texte">{bloc.texte}</p>
            </article>
          ))
        }
      </div>

      <div class="langues reveal">
        <h3 class="mono-label">Langues</h3>
        <p>Français, langue de travail. Anglais, lecture technique et échange professionnel.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .tete {
    position: relative;
    padding-block: clamp(1.5rem, 4vw, 2.5rem) clamp(2rem, 5vw, 3rem);
    overflow: hidden;
  }


  .tete__grille {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: start;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .tete__titre {
    font-size: var(--text-5xl);
    margin-bottom: 1.6rem;
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    max-width: 56ch;
    color: var(--c-text-2);
  }

  .bio a {
    color: var(--c-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .tete__portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-card);
    border: 1px solid var(--c-line);
  }

  .section--surface {
    background: var(--c-bg-elev);
    border-block: 1px solid var(--c-line);
  }

  .entete-section {
    max-width: 44rem;
    margin-bottom: clamp(2.25rem, 5vw, 3rem);
  }

  .entete-section__titre {
    margin-block: 1.1rem 0.9rem;
    font-size: var(--text-4xl);
  }

  /* ---------- Formation ---------- */

  .parcours {
    display: flex;
    flex-direction: column;
  }

  .parcours__item {
    display: grid;
    gap: 0.4rem 2rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--c-line);
  }

  .parcours__periode {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    color: var(--c-accent);
    padding-top: 0.3rem;
  }

  .parcours__titre {
    font-family: var(--font-titre);
    font-size: var(--text-xl);
    margin-bottom: 0.35rem;
  }

  .parcours__lieu {
    font-size: var(--text-sm);
    color: var(--c-text-2);
  }

  .parcours__detail {
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    color: var(--c-text-3);
    max-width: 54ch;
  }

  /* ---------- Méthode ---------- */

  .methode {
    display: grid;
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .methode__item {
    background: var(--c-bg);
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }

  .methode__titre {
    font-family: var(--font-titre);
    font-size: var(--text-lg);
    margin-bottom: 0.7rem;
  }

  .methode__texte {
    font-size: var(--text-sm);
    color: var(--c-text-2);
    max-width: 52ch;
  }

  .langues {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--c-line);
  }

  .langues h3 {
    margin-bottom: 0.7rem;
  }

  .langues p {
    font-size: var(--text-sm);
    color: var(--c-text-2);
  }

  @media (min-width: 44rem) {
    .parcours__item {
      grid-template-columns: 9rem minmax(0, 1fr);
    }

    .methode {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .tete__grille {
      grid-template-columns: 1.7fr 1fr;
    }
  }
</style>
